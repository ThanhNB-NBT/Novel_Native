<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- giữ lịch kiểm tra chương mới (NotifyJob) qua khởi động lại máy -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ ẩn app khác: không khai thì TextToSpeech không thấy engine đọc của ROM ("không có công cụ đọc") -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <!-- cleartext: endpoint dev là http://10.0.2.2:8000 qua ssh tunnel -->
    <application
        android:label="Gác Truyện Native"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NovelNative">
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <!-- biểu tượng app đổi được (AppIcon.kt): mỗi kiểu một alias mở MainActivity, bật đúng một cái; khớp iconStyles -->
        <activity-alias android:name=".LogoHolo" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoClassic" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_classic" android:roundIcon="@mipmap/ic_launcher_classic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoPearl" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_pearl" android:roundIcon="@mipmap/ic_launcher_pearl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoPaper" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_paper" android:roundIcon="@mipmap/ic_launcher_paper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoBand" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_band" android:roundIcon="@mipmap/ic_launcher_band">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoSon" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_son" android:roundIcon="@mipmap/ic_launcher_son">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoNgoc" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_ngoc" android:roundIcon="@mipmap/ic_launcher_ngoc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoCham" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_cham" android:roundIcon="@mipmap/ic_launcher_cham">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LogoHoang" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_launcher_hoang" android:roundIcon="@mipmap/ic_launcher_hoang">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- APK bản mới tải vào cacheDir/updates, chia cho trình cài hệ thống -->
        <service android:name=".TtsService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".NotifyJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".ContinueWidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_continue_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
